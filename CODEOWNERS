# Declared intent for the guardrail paths. The machine-checked enforcement is the
# `pr-rules` status check, and `harness/src/protected.mjs` is the AUTHORITATIVE
# list — this file mirrors it. With zero required approving reviews this file
# demands no review today — it becomes a real gate the moment a second person or
# bot has write access.
*                        @Oliver-ke
/.github/                @Oliver-ke
/infra/                  @Oliver-ke
/harness/                @Oliver-ke
/agent/                  @Oliver-ke
/CLAUDE.md               @Oliver-ke
/CODEOWNERS              @Oliver-ke
/app/tests/acceptance/   @Oliver-ke
/app/CLAUDE.md           @Oliver-ke
/app/AGENTS.md           @Oliver-ke
/package.json            @Oliver-ke
/package-lock.json       @Oliver-ke
/app/package.json        @Oliver-ke
/.nvmrc                  @Oliver-ke

# Config files are listed by stem, covering every extension the tool resolves —
# present or future, not just the ones enumerated here: a config the agent may
# add is a config it can use to shadow the one it may not edit.
/app/vitest.config.*     @Oliver-ke
/app/vitest.setup.*      @Oliver-ke
/app/tsconfig.json       @Oliver-ke
/app/eslint.config.*     @Oliver-ke
/app/next.config.*       @Oliver-ke
/app/postcss.config.*    @Oliver-ke
