{
  "name": "loop-sdlc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "workspaces": ["app", "harness"],
  "scripts": {
    "typecheck": "npm run typecheck --workspace app",
    "lint": "npm run lint --workspace app",
    "test": "npm run test:harness && npm run test:app",
    "test:harness": "node --test 'harness/test/**/*.test.mjs'",
    "test:app": "npm run test --workspace app",
    "build": "npm run build --workspace app",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "pr:check": "node harness/src/cli/check-pr.mjs"
  }
}
